# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Segredo usado para assinar o cookie de sessão.
# Gere um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-isto-por-uma-string-longa-e-aleatoria

# Porta do servidor
PORT=3000

# Modelo e esforço de raciocínio.
# effort: low | medium | high | xhigh | max  (medium é o equilíbrio bom/rápido)
MODEL=claude-opus-5
EFFORT=medium

# Nome da sua assessoria (aparece na interface)
NOME_ASSESSORIA=Assessoria

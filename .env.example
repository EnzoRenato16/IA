# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Segredo usado para assinar o cookie de sessão.
# Gere um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-isto-por-uma-string-longa-e-aleatoria

# Porta do servidor
PORT=3000

# Modelo forte: raciocínio, leitura de imagem, compliance.
MODEL=claude-opus-5

# Modelo barato para tarefas simples (~11x mais baixo que o Opus na prática).
# Cada comando escolhe qual usar, no campo "modelo:" do seu arquivo .md.
MODEL_RAPIDO=claude-haiku-4-5

# Profundidade do raciocínio do modelo forte: low | medium | high | xhigh | max
# (medium é o equilíbrio bom/rápido). Não se aplica ao modelo rápido.
EFFORT=medium

# Nome da sua assessoria (aparece na interface)
NOME_ASSESSORIA=Assessoria
